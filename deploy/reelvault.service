[Unit]
Description=ReelVault video server
After=network-online.target reelvault-service-sync.path
Wants=network-online.target reelvault-service-sync.path

[Service]
Type=simple
User=reelvault
Group=reelvault
WorkingDirectory=/opt/reelvault
EnvironmentFile=/etc/reelvault/reelvault.env
ExecStart=/opt/reelvault/.venv/bin/reelvault
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/reelvault /var/lib/reelvault-service-sync/requests

[Install]
WantedBy=multi-user.target
