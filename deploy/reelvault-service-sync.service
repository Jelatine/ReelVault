[Unit]
Description=Apply validated ReelVault service configuration
StartLimitIntervalSec=60
StartLimitBurst=20

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I /usr/local/libexec/reelvault-service-sync.py
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/systemd/system /var/lib/reelvault-service-sync
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
