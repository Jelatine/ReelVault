# Example reverse proxy for ReelVault. Get a certificate with certbot and set
# REELVAULT_SECURE_COOKIES=true when serving over HTTPS.
#
# Browsers only speak HTTP/2 over TLS. Over plain HTTP/1.1 they open at most six
# connections per host, which video range requests and the job event stream use
# up, so page requests queue behind playback.
server {
    listen 80;
    server_name videos.example.com;
    return 301 https://$host$request_uri;
}

server {
    # nginx before 1.25.1: use "listen 443 ssl http2;" instead of "http2 on;"
    listen 443 ssl;
    http2 on;
    server_name videos.example.com;

    ssl_certificate /etc/letsencrypt/live/videos.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/videos.example.com/privkey.pem;

    # Uploads are sent in 8 MB chunks
    client_max_body_size 64m;

    location / {
        proxy_pass http://127.0.0.1:34123;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
    }

    # Server-sent events for job progress
    location /api/jobs/events {
        proxy_pass http://127.0.0.1:34123;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}
