# Example reverse proxy for ReelVault. Get a certificate with certbot and set
# REELVAULT_SECURE_COOKIES=true when serving over HTTPS.
server {
    listen 80;
    server_name videos.example.com;

    # Uploads are sent in 8 MB chunks
    client_max_body_size 64m;

    location / {
        proxy_pass http://127.0.0.1:34123;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
    }

    # Server-sent events for job progress
    location /api/jobs/events {
        proxy_pass http://127.0.0.1:34123;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}
