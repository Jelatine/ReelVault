# ReelVault configuration (/etc/reelvault/reelvault.env)
REELVAULT_DATA_DIR=/var/lib/reelvault
REELVAULT_HOST=0.0.0.0
REELVAULT_PORT=8080
# Concurrent jobs: different videos run in parallel; shared video inputs serialize.
# A running paused job retains its worker slot.
REELVAULT_WORKERS=2
# Optional local Whisper transcription; install the transcription extra and prepare its model first.
#REELVAULT_TRANSCRIPTION_ENABLED=true
#REELVAULT_TRANSCRIPTION_MODEL=base
#REELVAULT_TRANSCRIPTION_THREADS=2
#REELVAULT_TRANSCRIPTION_MAX_HOURS=6
# Downloads are disabled during normal jobs; model preparation is an explicit deployment step.
#REELVAULT_TRANSCRIPTION_DOWNLOAD_MODEL=false
# Ubuntu install.sh enables its restricted, root-owned service synchronization helper.
REELVAULT_SYSTEMD_SYNC=true
# Leave empty to create the admin account in the browser on first visit
REELVAULT_ADMIN_USER=
REELVAULT_ADMIN_PASSWORD=
# "Remember me" lifetime (days) and normal session idle timeout (hours)
REELVAULT_REMEMBER_DAYS=30
REELVAULT_SESSION_IDLE_HOURS=12
# Set to true when served over HTTPS
REELVAULT_SECURE_COOKIES=false
# Optional folder with existing videos that can be imported from Settings
#REELVAULT_IMPORT_DIR=/srv/videos
